@{
Layout = "_Layout";
ViewBag.Titulo = "Listagem de Emprestimos";
}

@model List<ListarEmprestimosViewModel>;

    <a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

    @if (Model.Count == 0)
    {
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma caixa cadastrada.
    </div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Amigo</th>
                    <th>Revista</th>
                    <th>Status</th>
                    <th>Data de Empréstimo</th>
                    <th>Data de Devolução</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarEmprestimosViewModel e in Model)
                {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Amigo</td>
                    <td>@e.Revista</td>
                    <td>@e.Status</td>
                    <td>@e.Abertura</td>
                    <td>@e.ConclusaoPrevista</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar"
                                asp-route-id="@e.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir"
                                asp-route-id="@e.Id">Excluir</a>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
    }