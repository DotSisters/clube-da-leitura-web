@{
Layout = "_Layout";
ViewBag.Titulo = "Listagem de Emprestimos";
}

@model List<ListarEmprestimosViewModel>;

    <a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

    @if (Model.Count == 0)
    {
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma caixa cadastrada.
    </div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Amigo</th>
                    <th>Revista</th>
                    <th>Status</th>
                    <th>Data de Empréstimo</th>
                    <th>Data de Devolução</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarEmprestimosViewModel e in Model)
                {
                <tr class="@(e.EstaAtrasado ? "table-danger" : "")">
                    <td>@e.Id</td>
                    <td>@e.Amigo</td>
                    <td>@e.Revista</td>
                    <td>@e.Status</td>
                    <td>@e.Abertura.ToString("dd/MM/yyyy")</td>
                    <td>@e.ConclusaoPrevista.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (e.Status != "Concluido")
                        {
                            <a class="btn btn-outline-success btn-sm rounded-pill px-3"
                               asp-action="Devolver"
                               asp-route-id="@e.Id">
                                Devolver
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>
                                Devolvido
                            </button>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
    }
