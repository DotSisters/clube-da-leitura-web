@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Revista";
}

@model ExcluirRevistaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">

    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Tem certeza que deseja excluir esta revista?
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">ID</dt>
        <dd class="col-sm-8">@Model.Id</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Título</dt>
        <dd class="col-sm-8">@Model.Titulo</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Número da Edição</dt>
        <dd class="col-sm-8">@Model.NumeroEdicao</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Ano de Publicação</dt>
        <dd class="col-sm-8">@Model.AnoPublicacao</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Caixa</dt>
        <dd class="col-sm-8">@Model.Caixa</dd>
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
